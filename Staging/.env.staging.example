# Copy this file to Staging/.env.staging and replace every placeholder before running docker compose.
# Never commit .env.staging with real secrets.

# PostgreSQL 18 superuser & LumiDB roles (matches database/setup/01_roles.sql)
POSTGRES_PASSWORD=CHANGE_ME_postgres_root_password
LUMI_OWNER_PASSWORD=CHANGE_ME_lumi_owner_password
LUMI_APP_PASSWORD=CHANGE_ME_lumi_app_password
LUMI_REPORT_PASSWORD=CHANGE_ME_lumi_report_password

# Random secret >= 32 characters (e.g. openssl rand -hex 32)
LUMI_JWT_KEY=CHANGE_ME_GENERATE_AT_LEAST_32_CHARS_HEX_KEY_HERE

# Staging ports & rate limit
STAGING_PG_PORT=5432
STAGING_API_PORT=8080
STAGING_AUTH_RATE_LIMIT=30

# Only needed if running with `--profile https` (Caddy TLS proxy for Unity Client)
STAGING_DOMAIN=staging-lumi.your-domain.example
